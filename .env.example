# ══════════════════════════════════════════════════════════════════════════════
# GODO_VPS — Environment Variable Template
#
# Usage:
#   cp .env.example .env
#   Edit .env with real values after purchasing VPS
#
# This file is SAFE to commit — it contains only placeholders.
# .env is gitignored and must NEVER be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── VPS Provider ─────────────────────────────────────────────────────────────

# Human-readable label for this server (for logs and Telegram alerts)
VPS_PROVIDER=GigsGigsCloud SimpleCloud K+ Singapore

# ── VPS Connection ───────────────────────────────────────────────────────────

# Public IPv4 address of the VPS (get from provider control panel)
VPS_HOST=YOUR_VPS_IP_HERE

# SSH port — default 22, change after Phase 3 hardening (e.g. 52222)
VPS_SSH_PORT=22

# SSH user — start as root, switch to non-root user after Phase 3
VPS_USER=root

# Absolute path to your local SSH private key
# Generate with: ssh-keygen -t ed25519 -C "godo-vps"
VPS_SSH_KEY=~/.ssh/id_ed25519

# ── sing-box Ports ───────────────────────────────────────────────────────────

# VLESS+Reality listens on this TCP port (443 mimics HTTPS, harder to block)
SINGBOX_VLESS_PORT=443

# Hysteria2 listens on this UDP+TCP port
SINGBOX_HY2_PORT=8443

# ── VLESS + Reality Credentials ──────────────────────────────────────────────

# UUID for VLESS authentication — generate with: uuidgen
# or let godo-vps bootstrap auto-generate it
VLESS_UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Reality server name impersonation target
# Must be a real HTTPS site reachable from your VPS — cloudflare is reliable
REALITY_SNI=www.cloudflare.com

# X25519 key pair for Reality — generated by: godo-vps bootstrap
# Private key stays on server only — never share it
REALITY_PRIVATE_KEY=YOUR_REALITY_PRIVATE_KEY_BASE64URL_HERE

# Public key is shared with clients (safe to include in subscription links)
REALITY_PUBLIC_KEY=YOUR_REALITY_PUBLIC_KEY_BASE64URL_HERE

# Short ID — 8-byte hex string, must match between server and client
REALITY_SHORT_ID=YOUR_SHORT_ID_HEX_HERE

# ── Hysteria2 Credentials ────────────────────────────────────────────────────

# Password for Hysteria2 authentication — use a strong random string
# Generate with: openssl rand -hex 16
HY2_PASSWORD=YOUR_STRONG_HY2_PASSWORD_HERE

# ── Telegram Alerts (optional but recommended) ────────────────────────────────

# Create a bot via @BotFather → copy the token here
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Your Telegram user or group chat ID
# Get it by messaging @userinfobot
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ── Health Monitor ───────────────────────────────────────────────────────────

# Seconds between health checks when running: godo-vps monitor
HEALTH_CHECK_INTERVAL=300
